---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { allFaqs, faqCategories } from '../../data/faqs';
import { renderMarkdown } from '../../utils/markdown';

// Group faqs by category
const faqsByCategory = faqCategories.map(cat => ({
  ...cat,
  items: allFaqs.filter(f => f.category === cat.name)
}));

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": allFaqs.map(f => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": f.a.replace(/[*#`\n-]/g, ' ').replace(/\s+/g, ' ').trim().slice(0, 160)
    }
  }))
};
---

<BaseLayout
  title="Clash 使用与机场选购避坑指南与常见问答大全 (FAQ) | 机场clash"
  description="2026 最新 Clash 使用与机场选购常见问题解答大全。收录 IPLC/IEPL 专线原理、一键导入教程、订阅更新失败解决、TUN 模式配置、Netflix/ChatGPT 解锁故障排查，每个问答均支持独立页面跳转查阅。"
  keywords="Clash常见问题, 机场FAQ, 翻墙避坑指南, 订阅更新失败, 节点超时Timeout, TUN模式报错, Netflix解锁, ChatGPT 1020报错, 软路由OpenClash"
  canonicalPath="/faq"
>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-14 space-y-12">
    <!-- Header -->
    <div class="space-y-4 text-center max-w-3xl mx-auto">
      <nav class="flex items-center justify-center gap-2 text-xs text-slate-500">
        <a href="/" class="hover:text-blue-600 transition-colors">首页</a>
        <span>/</span>
        <span class="text-blue-600 dark:text-blue-400 font-medium">常见问答 (FAQ)</span>
      </nav>

      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black text-slate-900 dark:text-white tracking-tight">
        ❓ 翻墙新手避坑与常见疑问大全 (FAQ)
      </h1>
      <p class="text-sm sm:text-base text-slate-600 dark:text-slate-300 leading-relaxed">
        整理了从选购机场、专线原理、订阅更新报错排查到 ChatGPT / Netflix 流媒体解锁的最核心问答。<br class="hidden sm:inline" />
        每个问题均支持<strong>点击展开即时查阅</strong>或<strong>跳转至独立专属详情页面</strong>！
      </p>

      <!-- Category Quick Nav Pills -->
      <div class="flex flex-wrap items-center justify-center gap-2 pt-2">
        {faqCategories.map(cat => (
          <a
            href={`#${cat.name}`}
            class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full text-xs font-semibold bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-slate-700 dark:text-slate-200 hover:border-blue-500 hover:text-blue-600 dark:hover:text-blue-400 shadow-sm transition-all"
          >
            <span>{cat.icon}</span>
            <span>{cat.name}</span>
            <span class="text-[10px] px-1.5 py-0.2 rounded-full bg-slate-100 dark:bg-slate-700 text-slate-500">
              {allFaqs.filter(f => f.category === cat.name).length}
            </span>
          </a>
        ))}
      </div>
    </div>

    <!-- FAQ Sections by Category -->
    <div class="space-y-12">
      {faqsByCategory.map(section => (
        <section id={section.name} class="space-y-5 scroll-mt-24">
          <div class="flex items-center justify-between border-b border-slate-200 dark:border-slate-800 pb-3">
            <h2 class="text-xl sm:text-2xl font-black text-slate-900 dark:text-white flex items-center gap-2.5">
              <span class="text-2xl">{section.icon}</span>
              <span>{section.name}</span>
            </h2>
            <span class="text-xs text-slate-500 font-medium hidden sm:inline">
              {section.description}
            </span>
          </div>

          <div class="space-y-4">
            {section.items.map(item => (
              <details class="group bg-white dark:bg-slate-800/90 rounded-2xl border border-slate-200 dark:border-slate-700/80 p-5 sm:p-6 open:shadow-lg transition-all">
                <summary class="flex items-start justify-between font-bold text-slate-900 dark:text-white cursor-pointer list-none text-base sm:text-lg gap-4">
                  <div class="space-y-1">
                    <span class="hover:text-blue-600 transition-colors">{item.q}</span>
                    {item.summary && (
                      <p class="text-xs text-slate-500 dark:text-slate-400 font-normal line-clamp-1">
                        {item.summary}
                      </p>
                    )}
                  </div>
                  <span class="w-7 h-7 rounded-full bg-slate-100 dark:bg-slate-700 flex items-center justify-center text-slate-500 group-open:rotate-180 transition-transform shrink-0 mt-0.5">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                    </svg>
                  </span>
                </summary>

                <div class="mt-4 pt-4 border-t border-slate-100 dark:border-slate-700/80 space-y-4">
                  <div class="faq-content text-sm text-slate-700 dark:text-slate-300 leading-relaxed" set:html={renderMarkdown(item.a)} />

                  <!-- Direct Link Button to Single Page -->
                  <div class="pt-3 border-t border-slate-100 dark:border-slate-700/60 flex items-center justify-between">
                    <div class="flex items-center gap-1 text-[11px] text-slate-400">
                      <span>🏷️ {item.tags.join(' · ')}</span>
                    </div>

                    <a
                      href={`/faq/${item.slug}`}
                      class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-blue-50 dark:bg-blue-950/60 hover:bg-blue-100 dark:hover:bg-blue-900/60 text-blue-600 dark:text-blue-400 font-bold text-xs transition-colors shadow-xs"
                    >
                      <span>打开独立专属问答页</span>
                      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                      </svg>
                    </a>
                  </div>
                </div>
              </details>
            ))}
          </div>
        </section>
      ))}
    </div>

    <!-- Still Have Questions Banner -->
    <div class="bg-gradient-to-r from-blue-50 via-indigo-50 to-purple-50 dark:from-slate-800 dark:via-slate-800 dark:to-slate-800 rounded-3xl p-8 border border-blue-100 dark:border-slate-700 text-center space-y-4 mt-12 shadow-sm">
      <h3 class="text-lg sm:text-xl font-bold text-slate-900 dark:text-white">仍然没有找到您想要的解答？</h3>
      <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-300 max-w-xl mx-auto leading-relaxed">
        建议您先查阅我们整理的 <strong>Clash Verge Rev 保姆级新手图文教程</strong>，通常 90% 的连接与节点报错问题都能通过标准配置流程快速解决。
      </p>
      <div class="pt-2 flex flex-wrap items-center justify-center gap-3">
        <a href="/tutorials/clash-guide" class="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-blue-600 hover:bg-blue-700 text-white font-bold text-sm shadow-md transition-all">
          <span>查看新手保姆级图文配置教程</span>
          <span>&rarr;</span>
        </a>
        <a href="/" class="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-white dark:bg-slate-700 hover:bg-slate-50 dark:hover:bg-slate-600 text-slate-800 dark:text-white font-bold text-sm border border-slate-200 dark:border-slate-600 shadow-sm transition-all">
          <span>浏览 2026 精选机场榜单</span>
        </a>
      </div>
    </div>
  </div>
</BaseLayout>
