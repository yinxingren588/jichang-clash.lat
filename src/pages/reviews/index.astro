---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { airportsData } from '../../data/airports';
---

<BaseLayout
  title="所有机场测评汇总与深度评测文章 | 机场clash"
  description="机场clash 深度评测专栏。收录隐形人、暮光加速、大佬云、微风网络等各大优质机场的晚高峰测速、线路延迟、流媒体解锁报告及独家专属折扣码。"
  keywords="机场测评, 机场评测专栏, 隐形人测评, 暮光加速测评, 机场测速报告, 流媒体解锁实测, 机场选型指南, 翻墙机场哪家好"
  canonicalPath="/reviews"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 space-y-10">
    <div class="text-center max-w-3xl mx-auto space-y-3">
      <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 dark:text-white">
        📝 机场深度测评与分析专栏
      </h1>
      <p class="text-sm sm:text-base text-slate-500 dark:text-slate-400">
        点击任意机场查看真实测速数据、高峰期丢包率表现、流媒体全解报告及专属大额优惠券。
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {airportsData.map((item, idx) => (
        <a
          href={item.reviewSlug}
          class="group bg-white dark:bg-slate-800 rounded-2xl border border-slate-200 dark:border-slate-700/80 p-6 shadow-sm hover:shadow-xl hover:border-blue-400 dark:hover:border-blue-500 transition-all flex flex-col justify-between"
        >
          <div class="space-y-4">
            <div class="flex items-center justify-between">
              <span class="text-xs font-bold px-2 py-0.5 rounded bg-blue-50 dark:bg-blue-950 text-blue-700 dark:text-blue-300">
                #{idx + 1} 深度报告
              </span>
              <span class="text-xs text-slate-400">{item.uptime} 在线率</span>
            </div>

            <h2 class="text-xl font-bold text-slate-900 dark:text-white group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors">
              {item.name} 测评报告
            </h2>

            <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400 line-clamp-2">
              {item.tagline}
            </p>

            <div class="flex flex-wrap gap-1.5 pt-2">
              <span class="text-[11px] px-2 py-0.5 rounded bg-slate-100 dark:bg-slate-700 text-slate-600 dark:text-slate-300 font-medium">
                {item.lineType}
              </span>
              <span class="text-[11px] px-2 py-0.5 rounded bg-slate-100 dark:bg-slate-700 text-slate-600 dark:text-slate-300 font-medium">
                ⚡ {item.speedRating}
              </span>
            </div>
          </div>

          <div class="pt-6 mt-6 border-t border-slate-100 dark:border-slate-700 flex items-center justify-between">
            <span class="text-lg font-black text-blue-600 dark:text-blue-400">{item.price}</span>
            <span class="text-xs font-semibold text-blue-600 dark:text-blue-400 flex items-center gap-1 group-hover:translate-x-1 transition-transform">
              阅读完整测评报告 &rarr;
            </span>
          </div>
        </a>
      ))}
    </div>
  </div>
</BaseLayout>
