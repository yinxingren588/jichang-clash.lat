---
import { airportsData } from '../data/airports';

// Get exclusive partner airport (invisible)
const exclusiveAirport = airportsData.find(a => a.id === 'invisible') || airportsData[0];
---

<!-- Draggable Quick Sidebar -->
<aside
  id="draggable-quick-sidebar"
  class="fixed z-40 hidden sm:block select-none transition-shadow duration-200 shadow-2xl border border-slate-200/90 dark:border-slate-800 bg-white/95 dark:bg-slate-900/95 backdrop-blur-md rounded-2xl w-[268px] text-slate-800 dark:text-slate-100"
  style="top: 130px; right: 20px;"
  aria-label="快速导航与独家推荐"
>
  <!-- Sidebar Expanded Container -->
  <div id="quick-sidebar-body" class="p-3.5 space-y-3">
    
    <!-- Drag Handle & Controls -->
    <div
      id="quick-sidebar-handle"
      class="flex items-center justify-between pb-2 border-b border-slate-200/80 dark:border-slate-800 cursor-grab active:cursor-grabbing hover:bg-slate-50 dark:hover:bg-slate-800/50 -mx-1 px-1 py-0.5 rounded-lg transition-colors group"
      title="按住此处可任意拖拽快捷栏"
    >
      <div class="flex items-center gap-1.5 text-xs font-bold text-slate-700 dark:text-slate-300">
        <svg class="w-4 h-4 text-slate-400 group-hover:text-blue-500 transition-colors" viewBox="0 0 20 20" fill="currentColor">
          <path d="M7 2a2 2 0 1 0 .001 4.001A2 2 0 0 0 7 2zm0 6a2 2 0 1 0 .001 4.001A2 2 0 0 0 7 8zm0 6a2 2 0 1 0 .001 4.001A2 2 0 0 0 7 14zm6-12a2 2 0 1 0 .001 4.001A2 2 0 0 0 13 2zm0 6a2 2 0 1 0 .001 4.001A2 2 0 0 0 13 8zm0 6a2 2 0 1 0 .001 4.001A2 2 0 0 0 13 14z"/>
        </svg>
        <span>快捷直达</span>
        <span class="text-[10px] font-normal text-slate-400 dark:text-slate-500">(可拖动)</span>
      </div>

      <div class="flex items-center gap-1">
        <!-- Collapse Button -->
        <button
          id="quick-sidebar-collapse-btn"
          type="button"
          class="p-1 rounded-md text-slate-400 hover:text-slate-700 dark:hover:text-slate-200 hover:bg-slate-200/60 dark:hover:bg-slate-800 transition-colors"
          title="收起快捷栏"
          aria-label="收起快捷栏"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
          </svg>
        </button>
      </div>
    </div>

    <!-- TOP SECTION: Clash 独家合作机场 -->
    <div class="relative overflow-hidden rounded-xl border border-rose-200/80 dark:border-rose-900/60 bg-gradient-to-br from-rose-50/70 via-amber-50/40 to-white dark:from-rose-950/40 dark:via-slate-900 dark:to-slate-900 p-3 shadow-sm">
      
      <!-- Crown Header Banner -->
      <div class="flex items-center justify-between gap-1 mb-2">
        <div class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full bg-gradient-to-r from-rose-500 to-amber-500 text-white text-[10.5px] font-extrabold shadow-xs tracking-tight">
          <span>👑</span>
          <span>Clash 独家合作机场</span>
        </div>
        <span class="text-[11px] font-bold text-rose-600 dark:text-rose-400">8K秒开</span>
      </div>

      <!-- Airport Core Info -->
      <div class="flex items-center gap-2.5 mb-2.5">
        <img
          src={exclusiveAirport.logo}
          alt={exclusiveAirport.name}
          class="w-10 h-10 rounded-xl object-cover border border-rose-200 dark:border-rose-900 shadow-sm shrink-0"
        />
        <div class="min-w-0 flex-1">
          <div class="flex items-center gap-1">
            <span class="text-sm font-black text-slate-900 dark:text-white truncate">{exclusiveAirport.name}</span>
            <span class="text-[10px] font-bold text-amber-600 dark:text-amber-400 bg-amber-100 dark:bg-amber-950/70 px-1 py-0.2 rounded">官方直通</span>
          </div>
          <p class="text-[11px] text-slate-500 dark:text-slate-400 truncate">全 IEPL 物理专线 · 晚高峰不限速</p>
          <p class="text-xs font-bold text-rose-600 dark:text-rose-400 mt-0.5">
            {exclusiveAirport.price} <span class="text-[10px] font-normal text-slate-400">/ 80GB 起</span>
          </p>
        </div>
      </div>

      <!-- Exclusive Coupon Box -->
      <div class="mb-2.5 p-2 rounded-lg bg-white/90 dark:bg-slate-800/80 border border-rose-100 dark:border-rose-950 flex items-center justify-between gap-1">
        <div class="min-w-0">
          <span class="block text-[10px] text-slate-500 dark:text-slate-400">专属 8 折优惠券</span>
          <code class="text-xs font-mono font-extrabold text-rose-600 dark:text-rose-400 tracking-wider">yxr888</code>
        </div>
        <button
          type="button"
          class="copy-coupon-btn px-2.5 py-1 text-[11px] font-bold text-white bg-gradient-to-r from-rose-500 to-amber-500 hover:from-rose-600 hover:to-amber-600 rounded-md transition-all shadow-xs shrink-0 cursor-pointer"
          data-code="yxr888"
          title="点击一键复制优惠券"
        >
          复制
        </button>
      </div>

      <!-- Action Buttons -->
      <div class="grid grid-cols-2 gap-1.5">
        <a
          href="https://www.yinxingren.xyz/#/register?code=678125"
          target="_blank"
          rel="noopener noreferrer"
          class="col-span-2 flex items-center justify-center gap-1 py-1.5 px-2 bg-gradient-to-r from-rose-600 to-red-600 hover:from-rose-700 hover:to-red-700 text-white rounded-lg text-xs font-bold shadow-sm transition-all hover:shadow"
        >
          <span>直达官网开通</span>
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
          </svg>
        </a>
        <a
          href="/reviews/invisible"
          class="col-span-2 text-center py-1 text-[11px] font-medium text-slate-600 dark:text-slate-300 hover:text-rose-600 dark:hover:text-rose-400 transition-colors"
        >
          查看完整测评报告 →
        </a>
      </div>

    </div>

    <!-- QUICK LINKS SECTION -->
    <div class="space-y-1 pt-1">
      <div class="px-1 text-[10.5px] font-semibold text-slate-400 dark:text-slate-500 uppercase tracking-wider">
        常用直达
      </div>

      <nav class="grid grid-cols-2 gap-1 text-xs font-medium">
        <a
          href="/airports"
          class="flex items-center gap-1.5 px-2 py-1.5 rounded-lg hover:bg-slate-100 dark:hover:bg-slate-800 text-slate-700 dark:text-slate-200 hover:text-blue-600 dark:hover:text-blue-400 transition-colors"
        >
          <span>🏆</span>
          <span>机场精选</span>
        </a>
        <a
          href="/comparison"
          class="flex items-center gap-1.5 px-2 py-1.5 rounded-lg hover:bg-slate-100 dark:hover:bg-slate-800 text-slate-700 dark:text-slate-200 hover:text-blue-600 dark:hover:text-blue-400 transition-colors"
        >
          <span>📊</span>
          <span>参数对比</span>
        </a>
        <a
          href="/tutorials/clash-guide"
          class="flex items-center gap-1.5 px-2 py-1.5 rounded-lg hover:bg-slate-100 dark:hover:bg-slate-800 text-slate-700 dark:text-slate-200 hover:text-blue-600 dark:hover:text-blue-400 transition-colors"
        >
          <span>📖</span>
          <span>配置教程</span>
        </a>
        <a
          href="/clients"
          class="flex items-center gap-1.5 px-2 py-1.5 rounded-lg hover:bg-slate-100 dark:hover:bg-slate-800 text-slate-700 dark:text-slate-200 hover:text-blue-600 dark:hover:text-blue-400 transition-colors"
        >
          <span>📥</span>
          <span>客户端下载</span>
        </a>
        <a
          href="/faq"
          class="col-span-2 flex items-center justify-between px-2 py-1.5 rounded-lg hover:bg-slate-100 dark:hover:bg-slate-800 text-slate-700 dark:text-slate-200 hover:text-blue-600 dark:hover:text-blue-400 transition-colors"
        >
          <div class="flex items-center gap-1.5">
            <span>❓</span>
            <span>常见问答 (FAQ)</span>
          </div>
          <span class="text-[10px] text-blue-600 dark:text-blue-400 bg-blue-50 dark:bg-blue-950/60 px-1.5 py-0.5 rounded font-bold">58个专业解答</span>
        </a>
      </nav>
    </div>

    <!-- Scroll To Top Button -->
    <div class="pt-1 border-t border-slate-200/80 dark:border-slate-800">
      <button
        id="quick-sidebar-top-btn"
        type="button"
        class="w-full flex items-center justify-center gap-1 py-1.5 text-xs font-semibold text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white hover:bg-slate-100 dark:hover:bg-slate-800 rounded-lg transition-colors cursor-pointer"
      >
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 10l7-7m0 0l7 7m-7-7v18"></path>
        </svg>
        <span>回到顶部</span>
      </button>
    </div>

  </div>

  <!-- Collapsed State Button (Visible when folded) -->
  <div id="quick-sidebar-collapsed" class="hidden p-2">
    <button
      id="quick-sidebar-expand-btn"
      type="button"
      class="w-full flex items-center gap-2 px-3 py-2 bg-gradient-to-r from-rose-600 to-amber-600 text-white font-bold text-xs rounded-xl shadow-md hover:shadow-lg transition-all cursor-pointer"
      title="展开快捷导航"
    >
      <span>👑</span>
      <span>独家合作 · 快捷直达</span>
      <svg class="w-4 h-4 ml-auto" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
      </svg>
    </button>
  </div>
</aside>

<!-- Mobile Floating Bubble Button (on small mobile screens) -->
<div class="sm:hidden fixed bottom-5 right-4 z-40">
  <a
    href="https://www.yinxingren.xyz/#/register?code=678125"
    target="_blank"
    rel="noopener noreferrer"
    class="flex items-center gap-1.5 px-3 py-2 bg-gradient-to-r from-rose-600 to-amber-600 text-white font-bold text-xs rounded-full shadow-xl"
  >
    <span>👑</span>
    <span>独家合作: 隐形人</span>
  </a>
</div>

<script>
  // Draggable logic & collapse state
  document.addEventListener('DOMContentLoaded', () => {
    const sidebar = document.getElementById('draggable-quick-sidebar');
    const handle = document.getElementById('quick-sidebar-handle');
    const body = document.getElementById('quick-sidebar-body');
    const collapsed = document.getElementById('quick-sidebar-collapsed');
    const collapseBtn = document.getElementById('quick-sidebar-collapse-btn');
    const expandBtn = document.getElementById('quick-sidebar-expand-btn');
    const topBtn = document.getElementById('quick-sidebar-top-btn');

    if (!sidebar || !handle) return;

    // Scroll to top
    if (topBtn) {
      topBtn.addEventListener('click', () => {
        window.scrollTo({ top: 0, behavior: 'smooth' });
      });
    }

    // Collapse / Expand toggle
    if (collapseBtn && expandBtn && body && collapsed) {
      collapseBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        body.classList.add('hidden');
        collapsed.classList.remove('hidden');
        sidebar.classList.remove('w-[268px]');
        sidebar.classList.add('w-auto');
        localStorage.setItem('quick_sidebar_collapsed', 'true');
      });

      expandBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        body.classList.remove('hidden');
        collapsed.classList.add('hidden');
        sidebar.classList.add('w-[268px]');
        sidebar.classList.remove('w-auto');
        localStorage.setItem('quick_sidebar_collapsed', 'false');
      });

      // Restore collapse preference
      if (localStorage.getItem('quick_sidebar_collapsed') === 'true') {
        body.classList.add('hidden');
        collapsed.classList.remove('hidden');
        sidebar.classList.remove('w-[268px]');
        sidebar.classList.add('w-auto');
      }
    }

    // Drag & Drop Implementation
    let isDragging = false;
    let startX = 0;
    let startY = 0;
    let initialLeft = 0;
    let initialTop = 0;

    const onPointerDown = (e: MouseEvent | TouchEvent) => {
      // Don't drag if clicked on button or link inside handle
      const target = e.target as HTMLElement;
      if (target.closest('button') || target.closest('a')) return;

      isDragging = true;
      const clientX = 'touches' in e ? e.touches[0].clientX : e.clientX;
      const clientY = 'touches' in e ? e.touches[0].clientY : e.clientY;

      const rect = sidebar.getBoundingClientRect();
      startX = clientX;
      startY = clientY;
      initialLeft = rect.left;
      initialTop = rect.top;

      // Switch from right-based positioning to left-based
      sidebar.style.left = `${initialLeft}px`;
      sidebar.style.top = `${initialTop}px`;
      sidebar.style.right = 'auto';

      document.addEventListener('mousemove', onPointerMove);
      document.addEventListener('mouseup', onPointerUp);
      document.addEventListener('touchmove', onPointerMove, { passive: false });
      document.addEventListener('touchend', onPointerUp);
    };

    const onPointerMove = (e: MouseEvent | TouchEvent) => {
      if (!isDragging) return;

      if ('touches' in e) {
        e.preventDefault(); // prevent scrolling while dragging
      }

      const clientX = 'touches' in e ? e.touches[0].clientX : e.clientX;
      const clientY = 'touches' in e ? e.touches[0].clientY : e.clientY;

      const deltaX = clientX - startX;
      const deltaY = clientY - startY;

      const width = sidebar.offsetWidth;
      const height = sidebar.offsetHeight;
      const maxLeft = window.innerWidth - width - 10;
      const maxTop = window.innerHeight - height - 10;

      const newLeft = Math.max(10, Math.min(maxLeft, initialLeft + deltaX));
      const newTop = Math.max(10, Math.min(maxTop, initialTop + deltaY));

      sidebar.style.left = `${newLeft}px`;
      sidebar.style.top = `${newTop}px`;
    };

    const onPointerUp = () => {
      isDragging = false;
      document.removeEventListener('mousemove', onPointerMove);
      document.removeEventListener('mouseup', onPointerUp);
      document.removeEventListener('touchmove', onPointerMove);
      document.removeEventListener('touchend', onPointerUp);
    };

    handle.addEventListener('mousedown', onPointerDown);
    handle.addEventListener('touchstart', onPointerDown, { passive: true });
  });
</script>
